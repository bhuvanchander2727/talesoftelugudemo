# ============================================================
# Tales of Telugu — API Key Setup
# ============================================================
# This project uses gemini-config.js (not .env) for API keys.
#
# Steps:
#   1. Copy  gemini-config.example.js  →  gemini-config.js
#   2. Open  gemini-config.js
#   3. Replace YOUR_GEMINI_API_KEY_HERE with your real key.
#      Get a free key at: https://aistudio.google.com/app/apikey
#
# gemini-config.js is listed in .gitignore — your key won't be committed.
# ============================================================

# (Placeholder for reference only — actual key goes in gemini-config.js)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
